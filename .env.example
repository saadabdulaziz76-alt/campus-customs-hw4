# Campus Customs — environment template.
# Copy to .env and fill in. Never commit the real .env.

# Required for the shop assistant (Problem 5 onward).
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional — defaults shown.
# PORTKEY_MODEL=gpt-5.6-luna
# PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Optional: set this to keep login sessions valid across server restarts.
# If unset, a random secret is generated at startup (sessions end on restart).
# SESSION_SECRET=a-long-random-string
